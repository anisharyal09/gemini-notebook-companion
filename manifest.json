{
  "manifest_version": 3,
  "name": "Gemini Notebook Companion",
  "version": "1.1.1",
  "description": "Keep NotebookLM beside your research with a compact sidebar and reusable pop-out.",
  "minimum_chrome_version": "142",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Notebook Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Toggle Notebook sidebar"
    },
    "toggle-popout": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Open or close Notebook pop-out"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "shared.js",
        "popout-controls.js",
        "content.js"
      ],
      "css": [
        "compact.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://notebooklm.google.com https://notebook.google.com;"
  },
  "short_name": "Notebook"
}
